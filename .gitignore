# ---------------------------------------------------------------------------
# AiSteve — Git ignore rules
#
# Rule of thumb: source and hand-written files are committed; anything that can
# be regenerated by `./gradlew build`, downloaded by Gradle, or produced by
# running Minecraft is NOT. See docs/BUILD.md for the full build workflow.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Gradle build output  (regenerated by `./gradlew build`)
# ---------------------------------------------------------------------------
build/
!build.gradle
!build.gradle.kts
.gradle/
out/
bin/
*.class

# Gradle wrapper JAR is intentionally NOT ignored - see .gitattributes.
!gradle/wrapper/gradle-wrapper.jar

# ---------------------------------------------------------------------------
# Minecraft runtime  (created by `./gradlew runClient` / `runServer`)
# ---------------------------------------------------------------------------
run/
runs/
logs/
crash-reports/
debug/
saves/
screenshots/
resourcepacks/
shaderpacks/
mods/
mcmodsrepo/
*.mcmeta.bak

# ---------------------------------------------------------------------------
# Secrets — never commit a real API key
# ---------------------------------------------------------------------------
config/aisteve-common.toml
config/aisteve-capabilities.json
run/config/aisteve-common.toml
run/config/aisteve-capabilities.json
**/aisteve-common.toml.bak
*.secret
.env

# The example/template files ARE tracked (they contain no key).
!config/aisteve-common.toml.example

# ---------------------------------------------------------------------------
# IDE / editor
# ---------------------------------------------------------------------------
.idea/
*.iml
*.ipr
*.iws
.vscode/
*.code-workspace
.settings/
.classpath
.project
nbproject/
*.swp
*.swo
*~

# ---------------------------------------------------------------------------
# OS noise
# ---------------------------------------------------------------------------
.DS_Store
.AppleDouble
.LSOverride
._*
Thumbs.db
Desktop.ini
$RECYCLE.BIN/

# ---------------------------------------------------------------------------
# Java / JVM
# ---------------------------------------------------------------------------
hs_err_pid*.log
replay_pid*.log
jdk-17*/
jdk-21*/

# ---------------------------------------------------------------------------
# Logs & temporary files
# ---------------------------------------------------------------------------
*.log
*.tmp
*.bak
*.orig
*.rej

# ---------------------------------------------------------------------------
# Media — source repository should stay text-only
# ---------------------------------------------------------------------------
*.mp4
*.mov
*.avi
*.webm
*.mkv
*.flv

# Structure templates are generated, not authored.
*.nbt
